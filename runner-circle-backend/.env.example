# Porta HTTP da API
PORT=3000

# Conexão com o Postgres.
# Local (fora do Docker): use localhost. Dentro do compose, o host é "db".
DATABASE_URL=postgres://runner:runner@localhost:5432/runner_circle

# Segredo do JWT (troque em produção) e validade do token
JWT_SECRET=troque-esse-segredo-em-producao
JWT_EXPIRES_IN=7d

# URL base pública da API — usada para montar URLs absolutas de upload
API_BASE_URL=http://localhost:3000

# Origens de PRODUÇÃO liberadas no CORS (separadas por vírgula).
# Qualquer porta de localhost/127.0.0.1 já é liberada automaticamente (dev),
# então em dev pode deixar vazio.
CORS_ORIGINS=

# Logs de SQL do TypeORM (true/false)
DB_LOGGING=false

# Tamanho máximo de upload de imagem, em MB (a imagem é convertida para WebP)
UPLOAD_MAX_MB=15
